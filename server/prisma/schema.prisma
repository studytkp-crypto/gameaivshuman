datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  name             String?
  avatar           String?
  isPremium        Boolean   @default(false)
  stripeCustomerId String?
  streakFreezeUsed Boolean   @default(false)
  role             String    @default("user") // "user" | "admin"
  createdAt        DateTime  @default(now())

  attempts         Attempt[]
  streak           Streak?
}

model Round {
  id           String    @id @default(uuid())
  mode         String    @default("image") // "image" | "text" | "voice" | "art"
  category     String    // "Animals", "Portraits", "Food", "Architecture", "Nature", "Vehicles", "Cyberpunk"
  imageAUrl    String
  imageBUrl    String
  aiSlot       String    // "A" or "B"
  prompt       String?   // Prompt description
  realSource   String?   // Source credits for real image
  aiClues      String?   // Clues explaining why it is AI (e.g. lighting, finger count, texture)
  difficulty   String    @default("medium") // "easy" | "medium" | "hard"
  playsCount   Int       @default(0)
  correctCount Int       @default(0)
  createdAt    DateTime  @default(now())

  attempts         Attempt[]
  dailyChallenges DailyChallenge[]
}

model Attempt {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  guestIp    String?
  roundId    String
  round      Round    @relation(fields: [roundId], references: [id])
  chosenSlot String   // "A" or "B"
  correct    Boolean
  createdAt  DateTime @default(now())
}

model Streak {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  currentStreak  Int      @default(0)
  bestStreak     Int      @default(0)
  lastPlayedDate String?  // YYYY-MM-DD
}

model DailyChallenge {
  id          String   @id @default(uuid())
  roundId     String
  round       Round    @relation(fields: [roundId], references: [id])
  date        String   @unique // YYYY-MM-DD
  sponsorName String?
  sponsorLogo String?
  sponsorUrl  String?
}
